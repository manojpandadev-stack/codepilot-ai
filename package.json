{
  "name": "codepilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "description": "CodePilot AI — Production-Grade Agentic Software Engineering Platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:extension": "pnpm --filter codepilot-ai build",
    "build:packages": "pnpm --dir packages -r build",
    "build:webview": "pnpm --filter @codepilot/webview build",
    "benchmark": "tsx --tsconfig scripts/benchmark/tsconfig.json scripts/benchmark/run.ts",
    "dev:extension": "pnpm --filter @codepilot/vscode-extension dev",
    "dev:webview": "pnpm --filter @codepilot/webview dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "clean": "pnpm -r clean",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'apps/*/src/**/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
